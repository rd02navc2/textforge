    "nodemailer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "xlsx": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
